# Docker Compose PostgreSQL settings. Copy this file to .env and choose a local password.
POSTGRES_DB=brandshield
POSTGRES_USER=brandshield
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Backend settings
DATABASE_URL=postgresql+psycopg://brandshield:change-me-for-local-development@localhost:5432/brandshield
CORS_ORIGINS=http://localhost:5173

# Frontend settings (Vite only exposes variables prefixed with VITE_)
VITE_API_BASE_URL=http://127.0.0.1:8001
